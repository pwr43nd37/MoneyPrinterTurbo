# Claude Code 变体镜像：在官方发布镜像的基础上安装 claude CLI。
#
# Claude 订阅（Pro / Max / Team）不签发 API Key，只有 Claude Code 官方客户端
# 能使用订阅凭证，所以 `claude_code` Provider 依赖容器内存在可执行的 claude
# CLI。这里复用发布镜像，避免重新安装 Python 依赖。
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# CLI 版本固定，避免镜像重建时行为漂移；升级时改这里的版本号即可。
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_VERSION=22.11.0

# claude CLI 通过 npm 分发，发布镜像里没有 Node.js。
# 原先用 NodeSource apt 源，但其依赖 gnupg -> gpgsm，而 bullseye-security 镜像源上
# 该 .deb 已缺失（404），连带导致 nodejs/npm 装不上。改为直接下载 Node.js 官方
# 静态二进制，绕开 apt 源漂移，同时锁定版本避免行为漂移。
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl xz-utils; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch=x64 ;; \
      arm64) node_arch=arm64 ;; \
      *) echo "arquitetura nao suportada: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    node --version; \
    claude --version
